# --- STDIO entry point (src/index.ts), local/single-user use ---

# Required: Plausible API key (Settings > API Keys)
PLAUSIBLE_API_KEY=your-api-key-here

# Optional: Self-hosted Plausible URL (defaults to https://plausible.io)
# PLAUSIBLE_BASE_URL=https://analytics.mycompany.com

# Optional: restrict which site_id values this server will query. Unset means
# unrestricted for STDIO's single local user; the deployed HTTP server requires it.
# PLAUSIBLE_ALLOWED_SITES=example.com,other-example.com

# --- HTTP entry point (src/http-server.ts), deployed on Cloud Run ---
# No API key here: the HTTP server never holds one — each caller supplies their own via
# the Authorization header. See README "Self-Hosting" and TELEMETRY-adjacent notes in
# AGENTS.md for why that's load-bearing, not just a style choice.

# Required for the HTTP server: comma-separated allowlist of site_id values it will query.
# PLAUSIBLE_ALLOWED_SITES=example.com,other-example.com

# Optional: local in-memory rate-limit guards (defaults shown)
# RATE_LIMIT_PER_HOUR=500
# RATE_LIMIT_PER_KEY_PER_HOUR=200

# Optional: response size cap in bytes before rows are truncated (default shown)
# MAX_RESPONSE_BYTES=1048576

# Optional: HTTP port (Cloud Run sets this itself; default shown)
# PORT=8080

# --- Evals (pnpm eval), via OpenRouter ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
