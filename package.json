{
  "name": "plausible-mcp",
  "version": "0.7.1",
  "description": "MCP server for Plausible Analytics — arbitrary Stats API v2 queries and exhaustive breakdowns from any AI tool",
  "type": "module",
  "bin": {
    "plausible-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-server.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector --config mcp.json --server plausible-mcp",
    "inspect:cli": "pnpm build && npx @modelcontextprotocol/inspector --cli --config mcp.json --server plausible-mcp --method tools/list",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx evals/run.ts",
    "docker:build": "docker build -t plausible-mcp .",
    "docker:run": "docker run --rm -p 8080:8080 -e PLAUSIBLE_ALLOWED_SITES plausible-mcp"
  },
  "keywords": [
    "mcp",
    "plausible",
    "analytics",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "openai": "^7.1.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
